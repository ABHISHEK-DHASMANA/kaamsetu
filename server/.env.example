PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/kaamsetu
JWT_SECRET=
GEMINI_API_KEY=
CLIENT_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=
DEMO_MODE=true

# PhonePe PG V2 (configure only after merchant onboarding)
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=

# Email verification (Resend). Use a sender address on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=KaamSetu <verify@your-verified-domain.example>
FRONTEND_URL=https://your-kaamsetu-domain.example

# Firebase Admin must already be configured on the backend:
FIREBASE_PROJECT_ID=kaamsetu-83aef
FIREBASE_SERVICE_ACCOUNT_JSON=
